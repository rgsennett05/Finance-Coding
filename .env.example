# Copy this file to `.env` and fill in your keys. `.env` is never uploaded to GitHub.

# Alpaca PAPER trading keys (they start with "PK"). Never put live keys here.
# Get them at https://app.alpaca.markets  -> switch to "Paper Trading" -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Contact for the SEC's free company data (Fundamentals Analyst). The SEC requires a name and email.
# Example: TradingCity Jane Doe jane@example.com
SEC_USER_AGENT=

# Claude API key for the agents. https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
