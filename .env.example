# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is gitignored - never commit it.
# ---------------------------------------------------------------------------

# --- Plaid -----------------------------------------------------------------
# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox  -> fake data, no signup needed beyond the dashboard. Start here.
# production -> your real Robinhood + bank. Requires Plaid production access.
PLAID_ENV=sandbox

# Products to request. `investments` is what reaches Robinhood holdings.
PLAID_PRODUCTS=transactions,investments
PLAID_COUNTRY_CODES=US

# --- SEC EDGAR -------------------------------------------------------------
# SEC requires a descriptive User-Agent with a real contact address or they
# will rate-limit / block you. This is not optional.
SEC_USER_AGENT=FinanceCoding personal-tracker your.email@example.com

# --- Analyst ratings (optional) --------------------------------------------
# Leave blank to run without analyst data - every other feed still works.
# Finnhub free tier: https://finnhub.io/register
FINNHUB_API_KEY=

# --- Local server ----------------------------------------------------------
PORT=4000
DB_PATH=./data/finance.db
