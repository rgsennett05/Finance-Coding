# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is gitignored - never commit it.
# For the nightly GitHub run, add the same names as repository secrets instead.
# ---------------------------------------------------------------------------

# Required for DCF valuations. The SEC blocks requests without a contact email.
SEC_USER_AGENT=TickerCity your.email@example.com

# Optional: live quotes (free key at https://finnhub.io/register).
FINNHUB_API_KEY=

# Optional: opens the Research Library (Claude writes memos on the picks).
ANTHROPIC_API_KEY=
